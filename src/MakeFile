# --- VARIABLES ---

# Compilateur et Machine Virtuelle
JC = javac
JVM = java

# Dossiers
SRC_DIR = src
BIN_DIR = bin

# Options de compilation
# -d : dossier de destination des .class
# -sourcepath : chemin racine des sources
JFLAGS = -g -d $(BIN_DIR) -sourcepath $(SRC_DIR)

# Point d'entrée de l'application (Package.Classe)
MAIN_CLASS = app.Main

# Gestion de JavaFX (Décommentez et adaptez ces lignes si vous utilisez JDK 11+ sans gestionnaire de dépendances)
# JAVAFX_PATH = /chemin/vers/javafx-sdk/lib
# JFX_FLAGS = --module-path $(JAVAFX_PATH) --add-modules javafx.controls,javafx.fxml
# (Ajoutez $(JFX_FLAGS) dans les commandes compile et run si nécessaire)


# --- RECETTES ---

# Trouve tous les fichiers .java dans le dossier src (Linux/Mac/WSL)
SOURCES := $(shell find $(SRC_DIR) -name "*.java")

# Cible par défaut (quand on tape juste "make")
default: compile

# Compilation
compile:
	@mkdir -p $(BIN_DIR)
	@echo "Compilation des sources..."
	$(JC) $(JFLAGS) $(SOURCES)
	@echo "Compilation terminée avec succès."

# Exécution
run: compile
	@echo "Lancement de l'application..."
	$(JVM) -cp $(BIN_DIR) $(MAIN_CLASS)

# Nettoyage des fichiers compilés
clean:
	@echo "Nettoyage du dossier $(BIN_DIR)..."
	rm -rf $(BIN_DIR)
	@echo "Nettoyage terminé."